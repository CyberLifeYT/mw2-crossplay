<?xml version="1.0" encoding="utf-8"?>
<!-- PC-launcher mirror, compact single screen (landscape, no scrolling):
     right-aligned condensed entries with dividers left, detail pane with
     gold rule right, version tag top-right, glowing wordmark bottom-right,
     smoky BackdropView behind. Every entry keeps its action. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141417">

    <com.mw2.recomp.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/version_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#8B949E"
            android:textSize="9sp"
            android:fontFamily="sans-serif"
            tools:text="v0.1.0-alpha · TU0 · DISC VERSION 1.0.557" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/play"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/play"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/other_app"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/install"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/install_game"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/entry_mods"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/entry_mods"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/entry_tu6"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/entry_tu6"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="32dp"
                    android:background="#3A3A3E" />

                <Button
                    android:id="@+id/driver"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/graphics_driver"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/settings"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/entry_settings"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/view_log"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginStart="32dp"
                    android:background="#3A3A3E" />

                <Button
                    android:id="@+id/entry_updates"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/check_updates"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/entry_quit"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:background="@android:color/transparent"
                    android:gravity="end|center_vertical"
                    android:text="@string/quit_launcher"
                    android:textColor="#E8EAED"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/direct_launch_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:text="Direct launch on app start"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_default_title"
                    android:textColor="#F0F6FC"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="#C9A227" />

                <TextView
                    android:id="@+id/detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:text="@string/detail_default_text"
                    android:textColor="#B9BDC4"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:textColor="#C9D1D9"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="#8B949E"
                android:textSize="9sp"
                android:lineSpacingExtra="1dp"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wordmark_recompiled"
                    android:textColor="#8CE99A"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.14"
                    android:shadowColor="#2E7D32"
                    android:shadowRadius="10"
                    android:shadowDx="0"
                    android:shadowDy="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/disclaimer"
                    android:textColor="#6E7681"
                    android:textSize="7sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hint_choose"
                    android:textColor="#6E7681"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
